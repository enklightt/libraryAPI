# Copy this file to .env and fill in real values for local development.
# Never commit .env with real secrets.

# ASP.NET Core maps "__" to configuration sections.
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;Database=library_db;User=root;Password=CHANGE_ME;
JwtSettings__Secret=replace-with-a-random-secret-of-at-least-32-characters
JwtSettings__AccessTokenExpiryMinutes=60
JwtSettings__RefreshTokenExpiryDays=7

# Optional: AI assistant (Groq). Leave empty to disable the chat feature.
GroqSettings__ApiKey=
GroqSettings__Model=llama-3.3-70b-versatile

# Comma-separated origins (wildcard is not allowed by the API).
Cors__AllowedOrigins__0=http://localhost:5043
Cors__AllowedOrigins__1=https://localhost:7043

# Rate limiting (requests per client per window)
RateLimiting__Enabled=true
RateLimiting__AuthPermitLimit=10
RateLimiting__WritePermitLimit=60
RateLimiting__WindowSeconds=60

# In-memory caching
Caching__Enabled=true
Caching__BookListSeconds=30
Caching__BookSeconds=60
Caching__GenresSeconds=300

# Outbound HTTP resilience
Resilience__TimeoutSeconds=10
Resilience__AttemptTimeoutSeconds=5
Resilience__RetryCount=3
Resilience__CircuitBreakerFailureRatio=0.5
Resilience__CircuitBreakerMinimumThroughput=5
Resilience__CircuitBreakerSamplingSeconds=30
Resilience__CircuitBreakerBreakSeconds=15
