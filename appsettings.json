{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5043",
      "https://localhost:7043"
    ]
  },
  "JwtSettings": {
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "GroqSettings": {
    "Model": "llama-3.3-70b-versatile"
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "WritePermitLimit": 60,
    "WindowSeconds": 60
  },
  "Caching": {
    "Enabled": true,
    "BookListSeconds": 30,
    "BookSeconds": 60,
    "GenresSeconds": 300
  },
  "Resilience": {
    "TimeoutSeconds": 10,
    "AttemptTimeoutSeconds": 5,
    "RetryCount": 3,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerBreakSeconds": 15
  }
}
